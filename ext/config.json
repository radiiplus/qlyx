{
  "socket": {
    "url": "ws://127.0.0.1:14783/socket",
    "pulse": 20000,
    "limit": 100
  },
  "watch": {
    "delay": 150,
    "bytes": 1048576
  },
  "browser": {
    "timeout": 20000,
    "nodes": 80,
    "depth": 2,
    "read": 65536,
    "archive": 131072,
    "batch": 10,
    "jobs": 40,
    "events": 200
  },
  "agent": {
    "enabled": true,
    "delay": 300,
    "idle": 1500,
    "limit": 20,
    "message": 16384,
    "batch": 10,
    "prompt": "Use this Qlyx operation result to continue the current task through Observe -> Reason -> Act -> Verify -> Persist -> Continue. Explain in concise normal prose what completed, what failed, and what remains before requesting another action. If a batch has complete=false, handle the included results but wait for its remaining result updates. A successful browser_start only accepts asynchronous work; do not claim its operations completed until their browser_event results arrive. Report every failed or cancelled browser event and correlate it by job and operation id. After a material observation, decision, modification, test result, failure, handoff, or plan change, persist structured progress with autonomy_update or autonomy_event and update .agent/context.md with edit before continuing.",
    "start": "@@qlyx:result",
    "end": "@@qlyx:end:result"
  },
  "marks": [
    { "action": "batch", "start": "@@qlyx:batch", "end": "@@qlyx:end:batch" },
    { "action": "autonomy_state", "start": "@@qlyx:autonomy_state", "end": "@@qlyx:end:autonomy_state" },
    { "action": "autonomy_update", "start": "@@qlyx:autonomy_update", "end": "@@qlyx:end:autonomy_update" },
    { "action": "autonomy_event", "start": "@@qlyx:autonomy_event", "end": "@@qlyx:end:autonomy_event" },
    { "action": "list", "start": "@@qlyx:list", "end": "@@qlyx:end:list" },
    { "action": "read", "start": "@@qlyx:read", "end": "@@qlyx:end:read" },
    { "action": "create", "start": "@@qlyx:create", "end": "@@qlyx:end:create" },
    { "action": "edit", "start": "@@qlyx:edit", "end": "@@qlyx:end:edit" },
    { "action": "delete", "start": "@@qlyx:delete", "end": "@@qlyx:end:delete" },
    { "action": "exec", "start": "@@qlyx:exec", "end": "@@qlyx:end:exec" },
    { "action": "cancel", "start": "@@qlyx:cancel", "end": "@@qlyx:end:cancel" },
    { "action": "status", "start": "@@qlyx:status", "end": "@@qlyx:end:status" },
    { "action": "agent_list", "start": "@@qlyx:agent_list", "end": "@@qlyx:end:agent_list" },
    { "action": "agent_send", "start": "@@qlyx:agent_send", "end": "@@qlyx:end:agent_send" },
    { "action": "agent_batch", "start": "@@qlyx:agent_batch", "end": "@@qlyx:end:agent_batch" },
    { "action": "browser_open", "start": "@@qlyx:browser_open", "end": "@@qlyx:end:browser_open" },
    { "action": "browser_close", "start": "@@qlyx:browser_close", "end": "@@qlyx:end:browser_close" },
    { "action": "browser_tabs", "start": "@@qlyx:browser_tabs", "end": "@@qlyx:end:browser_tabs" },
    { "action": "browser_focus", "start": "@@qlyx:browser_focus", "end": "@@qlyx:end:browser_focus" },
    { "action": "browser_navigate", "start": "@@qlyx:browser_navigate", "end": "@@qlyx:end:browser_navigate" },
    { "action": "browser_back", "start": "@@qlyx:browser_back", "end": "@@qlyx:end:browser_back" },
    { "action": "browser_forward", "start": "@@qlyx:browser_forward", "end": "@@qlyx:end:browser_forward" },
    { "action": "browser_inspect", "start": "@@qlyx:browser_inspect", "end": "@@qlyx:end:browser_inspect" },
    { "action": "browser_expand", "start": "@@qlyx:browser_expand", "end": "@@qlyx:end:browser_expand" },
    { "action": "browser_click", "start": "@@qlyx:browser_click", "end": "@@qlyx:end:browser_click" },
    { "action": "browser_type", "start": "@@qlyx:browser_type", "end": "@@qlyx:end:browser_type" },
    { "action": "browser_scroll", "start": "@@qlyx:browser_scroll", "end": "@@qlyx:end:browser_scroll" },
    { "action": "browser_extract", "start": "@@qlyx:browser_extract", "end": "@@qlyx:end:browser_extract" },
    { "action": "browser_attributes", "start": "@@qlyx:browser_attributes", "end": "@@qlyx:end:browser_attributes" },
    { "action": "browser_evidence", "start": "@@qlyx:browser_evidence", "end": "@@qlyx:end:browser_evidence" },
    { "action": "browser_start", "start": "@@qlyx:browser_start", "end": "@@qlyx:end:browser_start" },
    { "action": "browser_status", "start": "@@qlyx:browser_status", "end": "@@qlyx:end:browser_status" },
    { "action": "browser_cancel", "start": "@@qlyx:browser_cancel", "end": "@@qlyx:end:browser_cancel" },
    { "action": "browser_snapshot", "start": "@@qlyx:browser_snapshot", "end": "@@qlyx:end:browser_snapshot" },
    { "action": "browser_find", "start": "@@qlyx:browser_find", "end": "@@qlyx:end:browser_find" },
    { "action": "browser_read", "start": "@@qlyx:browser_read", "end": "@@qlyx:end:browser_read" },
    { "action": "browser_interact", "start": "@@qlyx:browser_interact", "end": "@@qlyx:end:browser_interact" },
    { "action": "browser_dump", "start": "@@qlyx:browser_dump", "end": "@@qlyx:end:browser_dump" },
    { "action": "browser_batch", "start": "@@qlyx:browser_batch", "end": "@@qlyx:end:browser_batch" }
  ],
  "sites": [
    {
      "host": "chatgpt.com",
