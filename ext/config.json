{
  "socket": {
    "url": "ws://127.0.0.1:14783/socket",
    "pulse": 20000,
    "limit": 100
  },
  "watch": {
    "delay": 150,
    "bytes": 1048576
  },
  "agent": {
    "enabled": true,
    "delay": 300,
    "idle": 1500,
    "limit": 20,
    "prompt": "Use this Qlyx operation result to continue the current task.",
    "start": "@@qlyx:result",
    "end": "@@qlyx:end:result"
  },
  "marks": [
    { "action": "list", "start": "@@qlyx:list", "end": "@@qlyx:end:list" },
    { "action": "read", "start": "@@qlyx:read", "end": "@@qlyx:end:read" },
    { "action": "create", "start": "@@qlyx:create", "end": "@@qlyx:end:create" },
    { "action": "edit", "start": "@@qlyx:edit", "end": "@@qlyx:end:edit" },
    { "action": "delete", "start": "@@qlyx:delete", "end": "@@qlyx:end:delete" },
    { "action": "exec", "start": "@@qlyx:exec", "end": "@@qlyx:end:exec" },
    { "action": "status", "start": "@@qlyx:status", "end": "@@qlyx:end:status" }
  ],
  "sites": [
    {
      "host": "chatgpt.com",
      "reply": ["[data-message-author-role='assistant']"],
      "input": ["#prompt-textarea", "textarea[data-testid='prompt-textarea']"],
      "send": ["button[data-testid='send-button']", "button[aria-label*='Send' i]"],
      "stop": ["button[data-testid='stop-button']", "button[aria-label*='Stop' i]"],
      "busy": ["[data-message-author-role='assistant'][data-message-status='in_progress']", "[data-is-streaming='true']"]
    },
    {
      "host": "chat.openai.com",
      "reply": ["[data-message-author-role='assistant']"],
      "input": ["#prompt-textarea", "textarea[data-testid='prompt-textarea']"],
      "send": ["button[data-testid='send-button']", "button[aria-label*='Send' i]"],
      "stop": ["button[data-testid='stop-button']", "button[aria-label*='Stop' i]"],
      "busy": ["[data-message-author-role='assistant'][data-message-status='in_progress']", "[data-is-streaming='true']"]
    },
    {
      "host": "claude.ai",
      "reply": ["[data-testid='assistant-message']", ".font-claude-response"],
      "input": ["[contenteditable='true'][data-testid*='input']", ".ProseMirror[contenteditable='true']"],
      "send": ["button[data-testid*='send']", "button[aria-label*='Send' i]"],
      "stop": ["button[data-testid*='stop']", "button[aria-label*='Stop' i]"],
      "busy": ["[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "gemini.google.com",
      "reply": ["message-content", "[data-message-author-role='model']"],
      "input": ["rich-textarea [contenteditable='true']", ".ql-editor[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]"],
      "stop": ["button[aria-label*='Stop' i]"],
      "busy": ["model-response[aria-busy='true']", "[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "chat.deepseek.com",
      "reply": [".ds-markdown", "[data-role='assistant']"],
      "input": ["textarea", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", ".ds-loading", "[aria-busy='true']"]
    },
    {
      "host": "chat.qwen.ai",
      "reply": ["[data-role='assistant']", "[class*='assistant'] [class*='markdown']"],
      "input": ["textarea", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", "[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "kimi.ai",
      "reply": ["[data-role='assistant']", "[class*='assistant'] [class*='markdown']"],
      "input": ["textarea", ".ProseMirror[contenteditable='true']", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", "[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "www.kimi.ai",
      "reply": ["[data-role='assistant']", "[class*='assistant'] [class*='markdown']"],
      "input": ["textarea", ".ProseMirror[contenteditable='true']", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", "[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "kimi.com",
      "reply": ["[data-role='assistant']", "[class*='assistant'] [class*='markdown']"],
      "input": ["textarea", ".ProseMirror[contenteditable='true']", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", "[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "www.kimi.com",
      "reply": ["[data-role='assistant']", "[class*='assistant'] [class*='markdown']"],
      "input": ["textarea", ".ProseMirror[contenteditable='true']", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", "[data-is-streaming='true']", "[aria-busy='true']"]
    },
    {
      "host": "kimi.moonshot.cn",
      "reply": ["[data-role='assistant']", "[class*='assistant'] [class*='markdown']"],
      "input": ["textarea", ".ProseMirror[contenteditable='true']", "[contenteditable='true']"],
      "send": ["button[aria-label*='Send' i]", "button[data-testid*='send']"],
      "stop": ["button[aria-label*='Stop' i]", "button[data-testid*='stop']"],
      "busy": ["[data-state='streaming']", "[data-is-streaming='true']", "[aria-busy='true']"]
    }
  ]
}
